{
	"schemaVersion": 1,
	"id": "the-pickle-jar",
	"version": "${version}",
	"name": "The Pickle Jar",
	"description": "The Green Man has manifested a pickle jar with chaotic powers, unveil it to bring chaos to the world",
	"authors": [
		"D-man Hartey"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "ARR",
	"icon": "assets/the-pickle-jar/icon.png",
	"environment": "*",
	"entrypoints": {
      "main": [
        "net.dman.thepicklejar.ThePickleJar"
      ],
      "client": [
        "net.dman.thepicklejar.ThePickleJarClient"
      ],
      "fabric-datagen": [
        "net.dman.thepicklejar.ThePickleJarDataGenerator"
      ],
      "rei_client": [
        "net.dman.thepicklejar.compat.ThePickleJarREIClientPlugin"
      ],
      "emi": [
        "net.dman.thepicklejar.compat.ThePickleJarEMIClientPlugin"
      ],
		"cardinal-components-entity": [
			"net.dman.thepicklejar.component.ModComponents"
		]
    },
	"mixins": [
		"the-pickle-jar.mixins.json"
	],
	"custom": {
		"cardinal-components": [
			"the-pickle-jar:pickle_power"
		]
	},
	"depends": {
		"fabricloader": ">=0.17.2",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"pehkui": ">=3.8.2",
		"cardinal-components-entity": ">=5.2.3"
	},
	"suggests": {
		"another-mod": "*"
	}
}